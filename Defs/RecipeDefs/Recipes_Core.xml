    </descriptionHyperlinks>
  </RecipeDef>

  <RecipeDef>
    <defName>MakePrintedMeal</defName>
    <label>Make Printed meal (1 piece)</label>
    <description>The process of processing raw materials into synthesized meal</description>
    <jobString>Processing Printed meal.</jobString>
    <workAmount>1500</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>NutrientPasteRaw</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
