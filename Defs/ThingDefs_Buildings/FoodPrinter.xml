<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>FoodPrinter</defName>
    <label>Food printer</label>
    <description>Receives food raw materials and returns printed dishes</description>
    <thingClass>_3DPrinters.Building_AutoProcessor</thingClass>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Buildings/FoodPrinter/FoodPrinter</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <costList>
      <Steel>200</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <statBases>
      <Mass>40</Mass>
      <WorkToBuild>5000</WorkToBuild>
    </statBases>
    <designationCategory>_3DPrinters</designationCategory>
    <recipeMaker>
      <researchPrerequisite>NutrientRefiningTech</researchPrerequisite>
    </recipeMaker>
    <comps>
      <li Class="_3DPrinters.CompProperties_AutoProcessor">
        <baseWorkAmount>4000</baseWorkAmount>
        <requiredWorkType>Cooking</requiredWorkType>
        <supportedRecipes>
          <li>MakePrintedMeal</li>
          <li>MakePrintedMealTen</li>
        </supportedRecipes>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>50</basePowerConsumption>
      </li>
    </comps>
    <researchPrerequisites>
      <li>NutrientRefiningTech</li>
    </researchPrerequisites>

    <descriptionHyperlinks>
      <ThingDef>PrintedMeal</ThingDef>
      <RecipeDef>MakePrintedMeal</RecipeDef>
      <RecipeDef>MakePrintedMealTen</RecipeDef>
      <ThingDef>NutrientPasteRaw</ThingDef>
    </descriptionHyperlinks>
  </ThingDef>
</Defs>